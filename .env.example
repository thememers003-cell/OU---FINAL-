# Database
DATABASE_URL="postgresql://xpos:xpos_dev@localhost:5432/xpos?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# MinIO / S3
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_ACCESS_KEY="xpos_minio"
MINIO_SECRET_KEY="xpos_minio_secret"
MINIO_BUCKET="xpos-documents"
MINIO_USE_SSL=false

# API
API_PORT=4000
API_URL="http://localhost:4000"
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3002"

# Customer App
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_WS_URL="ws://localhost:4000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Payment (PhonePe / Mock)
PAYMENT_PROVIDER="phonepe"
PHONEPE_MERCHANT_ID="M236NFVVSAXD2"
PHONEPE_CLIENT_ID="SU2610191744120003675634"
PHONEPE_CLIENT_SECRET="your_phonepe_client_secret"
PHONEPE_ENV="production"
MOCK_PAYMENT_DELAY_MS=3000
MOCK_PAYMENT_AUTO_SUCCESS=false

# Printer (Mock)
PRINTER_SERVICE="mock"
MOCK_PRINT_PAGE_DELAY_MS=1000

# Print Codes
PRINT_CODE_EXPIRY_MINUTES=30
PRINT_CODE_LENGTH=6

# File Upload
MAX_FILE_SIZE_MB=50
FILE_RETENTION_MINUTES=30

# Kiosk
KIOSK_HEARTBEAT_INTERVAL_MS=30000
KIOSK_IDLE_TIMEOUT_MS=60000

# JWT Secret (for kiosk auth)
JWT_SECRET="xpos-dev-secret-change-in-production"

# Admin
